# OpenRouter repair assistant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=stealth/ox-alpha

# Required for real Google sign-in and persistent backend mode
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Firebase Google popup. Keep disabled until the matching
# Google OAuth client is configured in Supabase Auth.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_GOOGLE_LOGIN_ENABLED=false
